{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "峡印",
  "version": "0.2.0",
  "identifier": "com.sea.lol-skin-assistant",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "峡印",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": false,
        "shadow": true,
        "focus": true
      },
      {
        "label": "companion",
        "title": "峡印 · 选人小窗",
        "url": "index.html?window=companion",
        "width": 392,
        "height": 680,
        "minWidth": 340,
        "minHeight": 500,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "shadow": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "国服英雄联盟选人阶段皮肤助手",
    "longDescription": "托盘常驻，在英雄选择阶段展示并切换当前英雄可用皮肤。"
  }
}
